     "text": [
      "Yash\n"
     ]
    }
   ],
   "source": [
    "my_list = ['Yash', 'Johnny', 'Shalu', 'Sarh']\n",
    "\n",
    "i = 0\n",
    "\n",
    "while my_list[i] != 'Johnny':\n",
    "    print(my_list[i])\n",
    "    i += 1"
   ]
